# Server Configuration
NODE_ENV=development
PORT=4000

# Database
MONGO_URI=mongodb://localhost:27017/your_database_name

# Cloudinary Configuration
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# JWT Configuration
JWT_SECRET=your_very_secure_jwt_secret_key_here
JWT_EXPIRE=7d
COOKIE_EXPIRE=7
COOKIE_EXPIRES_TIME=7

# SendGrid Email Configuration
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_MAIL=noreply@yourdomain.com
SENDGRID_RESET_TEMPLATEID=your_reset_password_template_id
SENDGRID_ORDER_TEMPLATEID=your_order_confirmation_template_id

# Paytm Payment Gateway
PAYTM_MID=your_paytm_merchant_id
PAYTM_WEBSITE=your_paytm_website
PAYTM_CHANNEL_ID=your_paytm_channel_id
PAYTM_INDUSTRY_TYPE=your_paytm_industry_type
PAYTM_CUST_ID=your_paytm_customer_id
PAYTM_MERCHANT_KEY=your_paytm_merchant_key

# Optional: SMTP Configuration (if not using SendGrid)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SERVICE=gmail
# SMTP_MAIL=your_email@gmail.com
# SMTP_PASSWORD=your_email_password

# Optional: Stripe Payment (if needed)
# STRIPE_SECRET_KEY=your_stripe_secret_key
# STRIPE_API_KEY=your_stripe_api_key

# Optional: Email Configuration for Nodemailer
# ECOM_EMAIL=your_email@example.com
# ECOM_PASSWORD=your_email_password

# Optional: Transaction Collection for Fawn
# TRANS_COLL=your_transaction_collection_name
